<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>View Profile</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container">
        <h2>View Profile</h2>

        <!-- ฟอร์มแก้ไขโปรไฟล์ -->
        <form action="/user/edit/<%= user.User_id %>" method="POST">

            <!-- User Name -->
            <div class="form-group">
                <label for="User_Name">Username:</label>
                <input type="text" id="User_Name" name="User_Name" value="<%= user.User_Name %>" readonly>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label for="Email">Email:</label>
                <input type="email" id="Email" name="Email" value="<%= user.Email %>" readonly>
            </div>

            <!-- Profile Image -->
            <div class="form-group">
                <label>Current Profile Image:</label><br>
                <% if (user.Profile_Image && user.Profile_Image.length> 0) { %>
                    <% let lastImage=user.Profile_Image[user.Profile_Image.length - 1]; %>
                        <img src="<%= lastImage.Path %>" alt="Profile" width="100">
                        <% } else { %>
                            <p>No profile image uploaded.</p>
                            <% } %>

            </div>

            <!-- ฟอร์ม logout แบบ POST -->
            <form action="/user/logout" method="POST" style="display:inline;">
                <button type="submit" class="btn">Log Out</button>
            </form>

            <a href="/" class="btn">Home</a>

            <!-- ฟอร์ม logout แบบ POST -->
            <form action="/user/edit" method="GET" style="display:inline;">
                <button type="submit" class="btn">Edit Proflie</button>
            </form>

        </form>
    </div>
</body>

</html>