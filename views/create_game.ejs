<!-- ==========================
     create_game.ejs
     ========================== -->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- CSS ของ select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <title>Create Game</title>
</head>

<body>
    <h2>Create Game</h2>

    <!-- ==========================
         ฟอร์มสร้างเกม
         ========================== -->
    <form id="gameForm" action="/game/create" method="POST" enctype="multipart/form-data">

        <!-- ชื่อเกม -->
        <label for="title_game">Title Game: </label>
        <input type="text" name="title_game" id="title_game" required>
        <br>

        <!-- อัปโหลดรูปภาพเกม -->
        <label for="images_game">Upload Image Game (อย่างน้อย 1 รูป): </label>
        <input type="file" id="images_game" multiple>
        <div id="preview" style="display:flex; flex-wrap:wrap; gap:10px; margin-block-start:10px;"></div>
        <br>

        <!-- อัปโหลดไฟล์เกม -->
        <label for="file_game">Upload File Game (.zip): </label>
        <input type="file" id="file_game" accept=".zip">
        <div id="fileGameName" style="color:green; margin-block-start:5px;"></div>
        <br>

        <!-- คำอธิบายสั้น -->
        <label for="description">Short Description: </label>
        <input type="text" name="description" id="description" required>
        <br>

        <!-- สถานะการพัฒนาเกม -->
        <label for="status_game">Release Status: </label>
        <select name="status_game" id="status_game" required>
            <option value="Alpha">Alpha</option>
            <option value="Beta">Beta</option>
            <option value="Released">Released</option>
        </select>
        <br>

        <!-- รายละเอียดเพิ่มเติม -->
        <label for="details">Details: </label>
        <input type="text" name="details" id="details" required>
        <br>

        <!-- Tags -->
        <label for="tags">Tags (เลือกอย่างน้อย 1 ตัว): </label>
        <select id="tags" multiple="multiple">
            <option value="Action">Action</option>
            <option value="Adventure">Adventure</option>
            <option value="Card_Game">Card Game</option>
            <option value="Educational">Educational</option>
            <option value="Fighting">Fighting</option>
            <option value="Interactive_Fiction">Interactive Fiction</option>
            <option value="Puzzle">Puzzle</option>
            <option value="Racing">Racing</option>
            <option value="Other">Other</option>
        </select>
        <br>

        <!-- ปุ่มสร้างเกม -->
        <button type="submit">Create</button>
    </form>

    <!-- ==========================
         Script
         ========================== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
    $(document).ready(function () {
        $('#tags').select2({
            placeholder: "เลือก Tags",
            allowClear: true,
            tags: true
        });
    });

    let selectedFiles = [];
    let selectedGameFile = null;

    // preview รูปภาพ
    document.getElementById('images_game').addEventListener('change', function () {
        for (let file of this.files) selectedFiles.push(file);
        renderPreview();
        this.value = "";
    });
    function removeImage(index) {
        selectedFiles.splice(index, 1);
        renderPreview();
    }
    function renderPreview() {
        const preview = document.getElementById('preview');
        preview.innerHTML = "";
        selectedFiles.forEach((file, i) => {
            const div = document.createElement('div');
            div.style.position = "relative";
            const img = document.createElement('img');
            img.src = URL.createObjectURL(file);
            img.width = 150;
            const btn = document.createElement('button');
            btn.innerText = "✖";
            btn.style = "position:absolute;inset-block-start:0;inset-inline-end:0;background:red;color:white;border:none;cursor:pointer;";
            btn.onclick = () => removeImage(i);
            div.appendChild(img);
            div.appendChild(btn);
            preview.appendChild(div);
        });
    }

    // เลือกไฟล์เกม
    document.getElementById('file_game').addEventListener('change', function () {
        const file = this.files[0];
        const fileNameDiv = document.getElementById('fileGameName');
        if (file) {
            if (file.name.endsWith('.zip')) {
                selectedGameFile = file;
                fileNameDiv.innerText = "Selected: " + file.name;
            } else {
                alert("ไฟล์ต้องเป็น .zip เท่านั้น!");
                this.value = "";
                selectedGameFile = null;
                fileNameDiv.innerText = "";
            }
        }
    });

    // ส่งฟอร์ม
    document.getElementById("gameForm").addEventListener("submit", function (e) {
        e.preventDefault();

        if (selectedFiles.length < 1) { alert("กรุณาอัปโหลดรูปภาพอย่างน้อย 1 รูป"); return; }
        if (!selectedGameFile) { alert("กรุณาเลือกไฟล์เกม (.zip) ด้วย!"); return; }

        const selectedTags = $('#tags').val();
        if (!selectedTags || selectedTags.length === 0) { alert("กรุณาเลือก Tags อย่างน้อย 1 ตัว"); return; }

        const formData = new FormData(this);

        selectedFiles.forEach(file => formData.append("images", file));
        formData.append("file_game", selectedGameFile);
        selectedTags.forEach(tag => formData.append("tags[]", tag)); // ใช้ tags[] !!!

        fetch("/game/create", { method: "POST", body: formData })
            .then(res => res.json())
            .then(data => {
                if (data.error) { alert(data.error); return; }
                alert("สร้างเกมสำเร็จ!");
                window.location.href = "/game/view/" + data.game.Game_id;
            })
            .catch(err => console.error(err));
    });
    </script>

</body>

</html>