<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.Game_Title %> - Level Zero</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/view_game.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <!-- Hero Section -->
    <header class="game-hero" style="background-image: url('<%= (game.images && game.images.length > 0) ? game.images[0] : '' %>');">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1><%= game.Game_Title %></h1>
        </div>
    </header>

    <!-- Main Content -->
    <div class="game-page-container">
        <main class="left-column">
            <!-- About Section -->
            <section class="game-section">
                <h2>Details</h2>
                <div class="game-details">
                    <p><%= game.Description %></p>
                    <% if (game.Details) { %>
                        <p><%= game.Details %></p>
                    <% } %>
                </div>
            </section>

            <!-- Download Section -->
            <section class="game-section download-section">
                <h2>Download</h2>
                <a href="/game/download/<%= game.Game_id %>" class="btn btn-primary">Download Game</a>
            </section>

            <!-- Comments Section -->
            <section class="game-section">
                <h2>Comments</h2>
                <div class="comments-container">
                    <% if (user) { %>
                        <form action="/game/review/<%= game.Game_id %>" method="POST" class="comment-form">
                            <textarea name="comment" placeholder="Write your comment..." required></textarea>
                            <button type="submit" class="btn btn-secondary">Post Comment</button>
                        </form>
                    <% } else { %>
                        <p><a href="/user/login">Log in</a> to post a comment.</p>
                    <% } %>

                    <div class="comment-list">
                        <% reviews.forEach(r => { %>
                            <div class="comment">
                                <div class="comment-author">
                                    <strong><%= r.account ? r.account.User_Name : 'Unknown User' %></strong>
                                    <span class="comment-timestamp"><%= r.timeAgo %></span>
                                </div>
                                <p class="comment-body"><%= r.Comment %></p>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        </main>

        <aside class="right-column">
            <!-- Screenshots Section -->
            <div class="game-section">
                <div class="screenshot-gallery">
                    <% if (game.images && game.images.length > 0) { %>
                        <% game.images.slice(0, 3).forEach(image => { %>
                            <a href="<%= image %>" target="_blank">
                                <img src="<%= image %>" alt="Screenshot of <%= game.Game_Title %>">
                            </a>
                        <% }) %>
                    <% } else { %>
                        <a href="#" class="screenshot-placeholder">
                            <i class="fas fa-image"></i>
                        </a>
                        <a href="#" class="screenshot-placeholder">
                            <i class="fas fa-image"></i>
                        </a>
                        <a href="#" class="screenshot-placeholder">
                            <i class="fas fa-image"></i>
                        </a>
                    <% } %>
                </div>
            </div>

            <!-- Info Card -->
            <div class="info-card">
                <div class="info-item">
                    <strong>Developer</strong>
                    <span><%= game.developer.User_Name %></span>
                </div>
                <div class="info-item">
                    <strong>Release Status</strong>
                    <span class="status-tag"><%= game.Status_Game %></span>
                </div>
                 <div class="info-item">
                    <strong>Tags</strong>
                    <div class="tags-container">
                         <% if (game.tags && game.tags.length > 0) { %>
                            <% game.tags.forEach(tag => { %>
                                <span class="game-tag"><%= tag %></span>
                            <% }) %>
                        <% } else { %>
                            <span>No tags.</span>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Stats Card -->
             <div class="info-card stats-card">
                 <div class="stat-item">
                     <i class="fas fa-eye"></i>
                     <span><%= game.View || 0 %> Views</span>
                 </div>
                 <div class="stat-item">
                     <i class="fas fa-download"></i>
                     <span><%= game.Download || 0 %> Downloads</span>
                 </div>
                 <div class="stat-item">
                     <i class="fas fa-thumbs-up"></i>
                     <span><%= game.Like || 0 %> Likes</span>
                 </div>
             </div>
        </aside>
    </div>

    <footer class="footer">
        <p>&copy; 2025 Level Zero. All Rights Reserved.</p>
    </footer>
</body>
</html>