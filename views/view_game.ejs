<!-- ==========================
     views/view_game.ejs
     ========================== -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- ==========================
         CSS Libraries
         ========================== -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <title><%= game.Game_Title %></title>
</head>

<body>
    <a href="/" class="btn">Home</a>
    <h2>View Game</h2>

    <!-- ==========================
         Game Info (Read-Only)
         ========================== -->
    <h1><%= game.Game_Title %></h1>

    <!-- ชื่อเกม -->
    <label>Title:</label>
    <input type="text" value="<%= game.Game_Title %>" readonly>
    <br>

    <!-- คำอธิบายเกม -->
    <label>Description:</label>
    <textarea readonly><%= game.Description %></textarea>
    <br>

    <!-- สถานะเกม -->
    <label>Status:</label>
    <select disabled>
        <option value="Alpha" <%= game.Status_Game === "Alpha" ? "selected" : "" %>>Alpha</option>
        <option value="Beta" <%= game.Status_Game === "Beta" ? "selected" : "" %>>Beta</option>
        <option value="Released" <%= game.Status_Game === "Released" ? "selected" : "" %>>Released</option>
    </select>
    <br>

    <!-- รายละเอียดเพิ่มเติม -->
    <label>Details:</label>
    <textarea readonly><%= game.Details %></textarea>
    <br>

    <!-- Tags -->
    <label>Tags:</label>
    <select id="tags" multiple="multiple" disabled>
        <% const tagList = ["Action","Adventure","Card_Game","Educational","Fighting","Interactive_Fiction","Puzzle","Racing","Other"]; %>
        <% tagList.forEach(tag => { %>
            <option value="<%= tag %>" <%= game.tags?.[tag] === 1 ? "selected" : "" %>><%= tag.replace("_"," ") %></option>
        <% }) %>
    </select>
    <br>

    <!-- ==========================
         Game Images
         ========================== -->
    <h3>Game Images</h3>
    <div id="gameImages" style="display:flex; flex-wrap:wrap; gap:10px;">
        <% if(game.images && game.images.length > 0){ %>
            <% game.images.forEach(img => { %>
                <div style="position:relative;">
                    <img src="<%= img %>" width="150" style="border:1px solid #ccc; padding:2px;">
                </div>
            <% }) %>
        <% } else { %>
            <p>No images available.</p>
        <% } %>
    </div>
    <br>

    <!-- ==========================
         Download Game File
         ========================== -->
    <h3>Download Game File</h3>
    <% if(game.File_Game){ %>
        <a href="/game/file/<%= game.File_Game %>" download>
            <button type="button">Download Game (.zip)</button>
        </a>
    <% } else { %>
        <p>No game file available.</p>
    <% } %>
    <br><br>

    <!-- ==========================
         Comments Section
         ========================== -->
    <h3>Comments</h3>

    <!-- Post comment -->
    <form action="/game/review/<%= game.Game_id %>" method="POST">
        <textarea name="comment" placeholder="Write your comment..." required></textarea>
        <br>
        <button type="submit">Post Comment</button>
    </form>

    <!-- Display comments -->
    <% reviews.forEach(r => { %>
        <div class="comment" style="border-top:1px solid #ccc; padding:5px 0;">
            <strong><%= r.account ? r.account.User_Name : 'Unknown User' %></strong>
            <span style="color:gray; font-size:0.9em;"><%= r.timeAgo %></span>
            <p><%= r.Comment %></p>
        </div>
    <% }) %>

    <!-- ==========================
         JavaScript Libraries
         ========================== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- Initialize Select2 -->
    <script>
        $(document).ready(function () {
            $('#tags').select2({
                placeholder: "เลือก Tags",
                allowClear: true,
                tags: true
            });
        });
    </script>
</body>
</html>
