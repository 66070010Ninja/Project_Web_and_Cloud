<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Game Platform</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container">
        <h1>Welcome to Game Platform</h1>

        <!-- ปุ่มสร้างเกม (ถ้า user login) -->
        <% if (user) { %>
            <a href="/user/view/<%= user.id %>">Profile</a>
            <a href="/game/create" class="btn">Create New Game</a>
        <% } else { %>
            <a href="/user/login" class="btn">Login</a>
            <a href="/user/register" class="btn">Register</a>
        <% } %>

        <hr>

        <!-- ==========================
             แสดงรายการเกมทั้งหมด
             ========================== -->
        <h2>All Games</h2>

        <% if (games && games.length > 0) { %>
            <div class="game-list" style="display:flex; flex-wrap:wrap; gap:20px;">
                <% games.forEach(game => { %>
                    <div class="game-card" style="border:1px solid #ccc; padding:10px; width:200px;">
                        <h3><%= game.Game_Title %></h3>
                        <p>Status: <%= game.Status_Game %></p>
                        <p>Views: <%= game.View %></p>
                        <p>Downloads: <%= game.Download %></p>
                        <a href="/game/view/<%= game.Game_id %>">View Details</a>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <p>No games found.</p>
        <% } %>
    </div>
</body>

</html>
