<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Game Platform</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body>
    
    <%- include('partials/navbar') %>

    <div class="hero-banner">
        <div class="hero-content">
            <h1>LEVEL <span>ZERO</span></h1>
            <p class="slogan">"Let the world know your game."</p>
            <p class="slogan">"Make your name known in the game."</p>
        </div>
    </div>
    
    <div class="page-body">
        
        <aside class="sidebar">
            <h3>Popular Tags</h3>
            <ul class="tag-list">
                <li><a href="/tags/action">Action</a></li>
                <li><a href="/tags/adventure">Adventure</a></li>
                <li><a href="/tags/card-game">Card Game</a></li>
                <li><a href="/tags/educational">Educational</a></li>
                <li><a href="/tags/fighting">Fighting</a></li>
                <li><a href="/tags/interactive-fiction">Interactive Fiction</a></li>
                <li><a href="/tags/puzzle">Puzzle</a></li>
                <li><a href="/tags/racing">Racing</a></li>
                <li><a href="/tags/other">Other</a></li>
            </ul>
        </aside>

        <main class="content-area">
            <div class="container">
                <h2>Featured Game</h2>
                <% if (games && games.length > 0) { %>
                    <% const featuredGames = games.slice(0, Math.min(games.length, 3)); %>
                    <div class="featured-slider">
                        <div class="featured-main-display">
                            <div class="featured-image-container">
                                <a id="featured-link" href="">
                                    <img id="featured-image" src="" alt="Featured Game">
                                </a>
                            </div>
                            <div class="featured-info-container">
                                <h3 id="featured-title"></h3>
                                <p id="featured-description"></p>
                                <div id="featured-thumbnails" class="featured-thumbnails">
                                    <!-- Thumbnails for the current game will be generated by JS -->
                                </div>
                            </div>
                        </div>
                        <div class="featured-dots"></div>
                        <button id="featured-prev" class="featured-arrow prev">&lt;</button>
                        <button id="featured-next" class="featured-arrow next">&gt;</button>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const featuredGamesData = <%- JSON.stringify(featuredGames.map(g => ({
                                id: g.Game_id,
                                title: g.Game_Title,
                                description: g.Description,
                                images: (g.images && g.images.length > 0) ? g.images : [g.Game_Cover]
                            }))) %>;

                            if (featuredGamesData.length > 0) {
                                const mainImage = document.getElementById('featured-image');
                                const mainTitle = document.getElementById('featured-title');
                                const mainDescription = document.getElementById('featured-description');
                                const mainLink = document.getElementById('featured-link');
                                const thumbnailsContainer = document.getElementById('featured-thumbnails');
                                const dotsContainer = document.querySelector('.featured-dots');
                                const prevButton = document.getElementById('featured-prev');
                                const nextButton = document.getElementById('featured-next');

                                let currentGameIndex = 0;
                                
                                featuredGamesData.forEach((_, index) => {
                                    const dot = document.createElement('button');
                                    dot.classList.add('featured-dot');
                                    dot.dataset.index = index;
                                    dot.addEventListener('click', () => updateFeaturedGame(index));
                                    dotsContainer.appendChild(dot);
                                });
                                const dots = dotsContainer.querySelectorAll('.featured-dot');

                                function updateFeaturedGame(index) {
                                    const game = featuredGamesData[index];
                                    
                                    mainImage.src = game.images[0] || '';
                                    mainImage.alt = game.title;
                                    mainTitle.textContent = game.title;
                                    mainDescription.textContent = game.description.length > 120 ? game.description.substring(0, 120) + '...' : game.description;
                                    mainLink.href = `/game/view/${game.id}`;

                                    thumbnailsContainer.innerHTML = '';
                                    // Show up to 4 images for the thumbnails
                                    const imagesToShow = game.images.slice(0, 4);
                                    imagesToShow.forEach((imgSrc, thumbIndex) => {
                                        const thumb = document.createElement('img');
                                        thumb.src = imgSrc;
                                        thumb.alt = `${game.title} thumbnail ${thumbIndex + 1}`;
                                        thumb.classList.add('featured-thumb');
                                        if (thumbIndex === 0) {
                                            thumb.classList.add('active');
                                        }
                                        thumb.addEventListener('click', () => {
                                            mainImage.src = imgSrc;
                                            thumbnailsContainer.querySelectorAll('.featured-thumb').forEach(t => t.classList.remove('active'));
                                            thumb.classList.add('active');
                                        });
                                        thumbnailsContainer.appendChild(thumb);
                                    });
                                    
                                    dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
                                    currentGameIndex = index;
                                }

                                prevButton.addEventListener('click', () => {
                                    const newIndex = (currentGameIndex - 1 + featuredGamesData.length) % featuredGamesData.length;
                                    updateFeaturedGame(newIndex);
                                });

                                nextButton.addEventListener('click', () => {
                                    const newIndex = (currentGameIndex + 1) % featuredGamesData.length;
                                    updateFeaturedGame(newIndex);
                                });

                                updateFeaturedGame(0);
                            }
                        });
                    </script>
                <% } else { %>
                     <div class="placeholder-widget" style="height: 250px; margin-bottom: 40px;">
                        <p>Not enough games to feature.</p>
                         <% if (user) { %>
                            <a href="/game/create" class="btn">Create New Game</a>
                        <% } %>
                     </div>
                <% } %>

                <h2>Most Download</h2>
                <% if (games && games.length > 0) { %>
                    <div class="game-grid">
                        <% games.forEach(game => { %>
                            <div class="game-box">
                                <a href="/game/view/<%= game.Game_id %>" class="game-box-thumbnail">
                                    <img src="<% if (game.images && game.images.length > 0) { %><%= game.images[0] %><% } else { %><%= game.Game_Cover %><% } %>" alt="<%= game.Game_Title %>">
                                </a>
                                <div class="game-box-info">
                                    <h4 class="game-box-title"><%= game.Game_Title %></h4>
                                    <div class="game-box-stats">
                                        <span><i class="fas fa-download"></i> <%= game.downloads || 0 %></span>
                                        <span><i class="fas fa-thumbs-up"></i> <%= game.likes || 0 %></span>
                                        <span><i class="fas fa-eye"></i> <%= game.views || 0 %></span>
                                    </div>
                                    <p class="game-box-description"><%= game.Description %></p>
                                    <p class="game-box-status"><%= game.Status_Game %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p>No games found.</p>
                <% } %>
            </div>
        </main>

    </div>

    <footer class="footer">
        <p>&copy; 2025 Level Zero. All Rights Reserved.</p>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            
            // ดักจับการคลิกบนลิงก์ Popular Tags ทั้งหมด
            $('.tag-list a').on('click', function(e) {
                e.preventDefault(); // หยุดไม่ให้ลิงก์ทำงานตามปกติ (/tags/action)
                
                // 1. ดึงชื่อ Tag จากข้อความในลิงก์ (เช่น "Action")
                const tagName = $(this).text().trim();
                
                // 2. สร้าง URL สำหรับการค้นหาในหน้า Browse
                // เราจะส่ง Tag ไปใน query parameter ชื่อ 'tags'
                const searchUrl = `/browse/search?tags=${encodeURIComponent(tagName)}&sortOrder=newest`;
                
                // 3. นำทางผู้ใช้ไปยัง URL ค้นหา
                window.location.href = searchUrl;
            });
        });
    </script>

</body>
</html>