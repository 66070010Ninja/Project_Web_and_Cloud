<!-- ==========================
     edit_profile.ejs
     ========================== -->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit Profile</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container">
        <h2>Edit Profile</h2>

        <!-- ==========================
             ฟอร์มแก้ไขโปรไฟล์
             ========================== -->
        <form action="/user/edit/<%= user.User_id %>" method="POST" enctype="multipart/form-data">

            <!-- Username -->
            <div class="form-group">
                <label for="User_Name">Username:</label>
                <input type="text" id="User_Name" name="User_Name" value="<%= user.User_Name %>" required>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label for="Email">Email:</label>
                <input type="email" id="Email" name="Email" value="<%= user.Email %>" readonly>
            </div>

            <!-- Profile Image -->
            <div class="form-group">
                <label>Current Profile Image:</label><br>
                <% if (user.Profile_Image && user.Profile_Image.length > 0) { %>
                    <img src="<%= user.Profile_Image[0].Path %>" alt="Profile" width="100"><br>
                <% } else { %>
                    <p>No profile image uploaded.</p>
                <% } %>
                <label for="Profile_Image">Choose new profile image:</label>
                <input type="file" id="Profile_Image" name="Profile_Image" accept="image/*">
            </div>

            <!-- ปุ่มอัปเดตโปรไฟล์ -->
            <button type="submit">Update Profile</button>
        </form>

        <!-- ฟอร์ม cancel กลับหน้า view -->
        <form action="/user/view/<%= user.User_id %>" method="GET" style="display:inline;">
            <button type="submit" class="btn">Cancel</button>
        </form>
    </div>
</body>

</html>
