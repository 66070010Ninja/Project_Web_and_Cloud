<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Game - <%= game.Game_Title %></title>
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/edit_game.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <%- include('partials/navbar') %>

    <div class="main-container">
        <form id="editGameForm" class="create-game-form" action="/game/edit/<%= game.Game_id %>" method="POST" enctype="multipart/form-data">
            
            <div class="form-header">
                <h1>Edit: <%= game.Game_Title %></h1>
            </div>

            <div class="form-body">
                <!-- Left Column -->
                <div class="form-column left">
                    <div class="form-group">
                        <label for="Game_Title">Title Game</label>
                        <input type="text" id="Game_Title" name="Game_Title" class="form-control" value="<%= game.Game_Title %>" required>
                    </div>

                    <div class="form-group">
                        <label for="Description">Short description</label>
                        <textarea id="Description" name="Description" class="form-control" rows="4"><%= game.Description %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="Details">Details</label>
                        <textarea id="Details" name="Details" class="form-control" rows="6"><%= game.Details %></textarea>
                    </div>

                     <div class="form-group">
                        <label for="Status_Game">Release status</label>
                        <select id="Status_Game" name="Status_Game" class="form-control">
                            <option value="In development" <%= game.Status_Game === 'In development' ? 'selected' : '' %>>In development</option>
                            <option value="Released" <%= game.Status_Game === 'Released' ? 'selected' : '' %>>Released</option>
                            <option value="Alpha" <%= game.Status_Game === 'Alpha' ? 'selected' : '' %>>Alpha</option>
                            <option value="Beta" <%= game.Status_Game === 'Beta' ? 'selected' : '' %>>Beta</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="tags">Tags</label>
                        <select id="tags" name="tags" class="form-control" multiple="multiple">
                             <option value="Action">Action</option>
                            <option value="Adventure">Adventure</option>
                            <option value="Card_Game">Card Game</option>
                            <option value="Educational">Educational</option>
                            <option value="Fighting">Fighting</option>
                            <option value="Interactive_Fiction">Interactive Fiction</option>
                            <option value="Puzzle">Puzzle</option>
                            <option value="Racing">Racing</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="form-column right">
                    <div class="form-group">
                        <label>Current Screenshots</label>
                        <div id="existingImagesPreview" class="image-preview-container"></div>

                        <div id="existingImagesInputs">
                            <% game.images.forEach(img => { %>
                                <input type="hidden" name="existingImages[]" value="<%= img.Game_Image_id %>" id="existing-img-<%= img.Game_Image_id %>">
                            <% }) %>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="images">Upload New Screenshots</label>
                        <div class="upload-box" id="imageUploadBox">
                            <input type="file" id="images" class="file-input" multiple>
                            <div class="upload-content">
                                <i class="fas fa-images"></i>
                                <p><strong>Drag & drop images here</strong><br>or click to select files</p>
                            </div>
                        </div>
                        <div id="newImagesPreview" class="image-preview-container"></div>
                    </div>

                    <div class="form-group">
                        <label for="file_game">Upload New Game File (.zip)</label>
                        
                        <% if (game && game.File_Game) { %>
                            <div class="current-file-info">
                                <strong>Current File:</strong> <%= game.File_Game.split('/').pop() %>
                            </div>
                        <% } %>

                        <div class="upload-box" id="fileUploadBox">
                             <input type="file" id="file_game" class="file-input" accept=".zip">
                             <div class="upload-content">
                                <i class="fas fa-file-archive"></i>
                                <p><strong>Drag & drop a .zip file here</strong><br>or click to select a file</p>
                            </div>
                        </div>
                        <div id="fileName" class="file-name-display"></div>
                    </div>
                </div>
            </div>

            <div class="form-footer">
                 <button type="submit" class="btn btn-primary">Save Changes</button>
                 <button type="button" class="btn btn-danger" id="deleteGameBtn">Delete Game</button>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // Immediately-invoked function expression (IIFE) to avoid global scope pollution
        (function() {
            const gameData = <%- JSON.stringify(game) %>;
            let newImageFiles = [];
            let newGameFile = null;
            let imagesToDelete = [];

            // Initialize Select2 for tags
            $('#tags').select2({
                placeholder: "Select tags for your game",
                allowClear: true
            }).val(gameData.tags).trigger('change');

            // Image Upload Logic
            const imageUploadBox = document.getElementById('imageUploadBox');
            const imageInput = document.getElementById('images');
            const newImagesPreview = document.getElementById('newImagesPreview');
            const existingImagesInputs = document.getElementById('existingImagesInputs');
            const existingImagesPreview = document.getElementById('existingImagesPreview');

            function setupDragAndDrop(box, input, onFiles) {
                box.addEventListener('click', () => input.click());
                box.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    box.classList.add('dragover');
                });
                box.addEventListener('dragleave', () => box.classList.remove('dragover'));
                box.addEventListener('drop', (e) => {
                    e.preventDefault();
                    box.classList.remove('dragover');
                    if (e.dataTransfer.files.length) {
                        input.files = e.dataTransfer.files;
                        const changeEvent = new Event('change', { bubbles: true });
                        input.dispatchEvent(changeEvent);
                    }
                });
                input.addEventListener('change', () => onFiles(input.files));
            }

            function renderExistingImages() {
                existingImagesPreview.innerHTML = '';
                gameData.images.forEach(img => {
                    const wrapper = document.createElement('div');
                    wrapper.classList.add('image-preview-wrapper');
                    wrapper.innerHTML = `
                        <img src="${img.Path}" alt="Game Image" class="image-preview">
                        <button type="button" class="remove-img-btn" data-id="${img.Game_Image_id}">×</button>
                    `;
                    existingImagesPreview.appendChild(wrapper);
                });
            }

            existingImagesPreview.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-img-btn')) {
                    const imageId = parseInt(e.target.dataset.id, 10);

                    // ลบจาก imagesToDelete
                    if (!imagesToDelete.includes(imageId)) {
                        imagesToDelete.push(imageId);
                    }

                    // ลบ preview
                    e.target.parentElement.remove();

                    // ลบ hidden input ของ existingImages[]
                    const hiddenInput = document.getElementById(`existing-img-${imageId}`);
                    if (hiddenInput) hiddenInput.remove();

                    // สร้าง hidden input สำหรับ delete_images[]
                    const deleteInput = document.createElement('input');
                    deleteInput.type = 'hidden';
                    deleteInput.name = 'delete_images[]';
                    deleteInput.value = imageId;
                    document.getElementById('editGameForm').appendChild(deleteInput);
                }
            });

            function renderNewImagesPreview() {
                newImagesPreview.innerHTML = '';
                newImageFiles.forEach((file, index) => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'image-preview-wrapper';
                    wrapper.innerHTML = `
                        <img src="${URL.createObjectURL(file)}" class="image-preview" alt="New Screenshot">
                        <button type="button" class="remove-img-btn" data-index="${index}">×</button>
                    `;
                    newImagesPreview.appendChild(wrapper);
                });
            }
            
            newImagesPreview.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-img-btn')) {
                    const index = parseInt(e.target.dataset.index, 10);
                    newImageFiles.splice(index, 1);
                    renderNewImagesPreview();
                }
            });

            setupDragAndDrop(imageUploadBox, imageInput, (files) => {
                newImageFiles.push(...Array.from(files));
                renderNewImagesPreview();
            });

            // File Upload Logic
            const fileUploadBox = document.getElementById('fileUploadBox');
            const fileInput = document.getElementById('file_game');
            const fileNameDisplay = document.getElementById('fileName');
            
            setupDragAndDrop(fileUploadBox, fileInput, (files) => {
                const file = files[0];
                if (file && file.name.endsWith('.zip')) {
                    newGameFile = file;
                    fileNameDisplay.textContent = `Selected new file: ${file.name}`;
                    fileNameDisplay.style.display = 'block';
                } else {
                    alert('Please select a .zip file.');
                    newGameFile = null;
                    fileNameDisplay.textContent = '';
                    fileNameDisplay.style.display = 'none';
                }
            });

            // Form Submission
            document.getElementById('editGameForm').addEventListener('submit', function(e) {
                e.preventDefault();

                const formData = new FormData(this);
                formData.delete('images'); 
                formData.delete('file_game');

                newImageFiles.forEach(file => formData.append('images', file));
                if (newGameFile) formData.append('file_game', newGameFile);
                imagesToDelete.forEach(id => formData.append('delete_images[]', id));

                fetch(this.action, { method: "POST", body: formData })
                    .then(res => res.json())
                    .then(data => {
                        if (data.error) {
                            alert(`Error: ${data.error}`);
                            return;
                        }
                        alert("Game updated successfully!");
                        window.location.href = `/game/view/${gameData.Game_id}`;
                    })
                    .catch(err => {
                        console.error('Submission error:', err);
                        alert('An error occurred while saving. Please check the console.');
                    });
            });

            // Delete Game Button
            document.getElementById('deleteGameBtn').addEventListener('click', function() {
                if (confirm('Are you sure you want to delete this game? This action cannot be undone.')) {
                    fetch(`/game/delete/${gameData.Game_id}?from=edit`, { method: 'POST' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                alert('Game deleted successfully.');
                                window.location.href = '/dashboard';
                            } else {
                                alert(`Error: ${data.error}`);
                            }
                        })
                        .catch(err => {
                            console.error('Delete error:', err);
                            alert('An error occurred during deletion.');
                        });
                }
            });
            
            // Initial render on page load
            renderExistingImages();
        })();
    </script>
</body>
</html>
