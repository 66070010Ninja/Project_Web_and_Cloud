<!-- ==========================
     views/edit_game.ejs
     ========================== -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Select2 CSS สำหรับ multi-select -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <title>Edit Game</title>
</head>

<body>
    <h2>Edit Game</h2>

    <!-- ==========================
         Form สำหรับแก้ไขเกม
         ========================== -->
    <form action="/game/edit/<%= game.Game_id %>" method="POST">
        <h1>Edit Game: <%= game.Game_Title %>
        </h1>

        <!-- ชื่อเกม -->
        <label>Title:</label>
        <input type="text" name="Game_Title" value="<%= game.Game_Title %>" required><br>

        <!-- คำอธิบายเกม -->
        <label>Description:</label>
        <textarea name="Description"><%= game.Description %></textarea><br>

        <!-- สถานะเกม -->
        <label>Status:</label>
        <select name="status_game" id="status_game" required>
            <option value="Alpha" <%=game.Status_Game==="Alpha" ? "selected" : "" %>>Alpha</option>
            <option value="Beta" <%=game.Status_Game==="Beta" ? "selected" : "" %>>Beta</option>
            <option value="Released" <%=game.Status_Game==="Released" ? "selected" : "" %>>Released</option>
        </select>
        <br>

        <!-- รายละเอียดเพิ่มเติม -->
        <label>Details:</label>
        <textarea name="Details"><%= game.Details %></textarea><br>

        <!-- เลือก Tags ของเกม (multi-select) -->
        <label for="tags">Tags:</label>
        <select id="tags" name="tags[]" multiple="multiple">
            <option value="Action" <%=game.tags?.Action ? "selected" : "" %>>Action</option>
            <option value="Adventure" <%=game.tags?.Adventure ? "selected" : "" %>>Adventure</option>
            <option value="Card_Game" <%=game.tags?.Card_Game ? "selected" : "" %>>Card Game</option>
            <option value="Educational" <%=game.tags?.Educational ? "selected" : "" %>>Educational</option>
            <option value="Fighting" <%=game.tags?.Fighting ? "selected" : "" %>>Fighting</option>
            <option value="Interactive_Fiction" <%=game.tags?.Interactive_Fiction ? "selected" : "" %>>Interactive
                Fiction</option>
            <option value="Puzzle" <%=game.tags?.Puzzle ? "selected" : "" %>>Puzzle</option>
            <option value="Racing" <%=game.tags?.Racing ? "selected" : "" %>>Racing</option>
            <option value="Other" <%=game.tags?.Other ? "selected" : "" %>>Other</option>
        </select><br>

        <!-- ปุ่มส่งฟอร์ม -->
        <button type="submit">Update</button>
    </form>

    <!-- ==========================
         Script สำหรับ jQuery และ Select2
         ========================== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            // ใช้งาน Select2 สำหรับ multi-select tags
            $('#tags').select2({
                placeholder: "เลือก Tags",  // ข้อความ placeholder
                allowClear: true,            // สามารถลบค่าที่เลือกได้
                tags: true                   // เพิ่ม tag ใหม่ได้เอง
            });
        });
    </script>
</body>

</html>