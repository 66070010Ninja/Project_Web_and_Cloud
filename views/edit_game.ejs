<!-- ==========================
     edit_game.ejs
     ========================== -->

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- CSS ของ select2 สำหรับ multi-select -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <title>Edit Game</title>
</head>

<body>
    <h2>Edit Game</h2>

    <!-- ==========================
         ฟอร์มแก้ไขเกม
         ========================== -->
    <form action="/game/edit/<%= game.Game_id %>" method="POST" enctype="multipart/form-data">
        <h1>Edit Game: <%= game.Game_Title %></h1>

        <!-- ชื่อเกม -->
        <label for="Game_Title">Title:</label>
        <input type="text" name="Game_Title" id="Game_Title" value="<%= game.Game_Title %>" required>
        <br>

        <!-- คำอธิบายสั้น -->
        <label for="Description">Description:</label>
        <textarea name="Description" id="Description"><%= game.Description %></textarea>
        <br>

        <!-- สถานะการพัฒนาเกม -->
        <label for="status_game">Status:</label>
        <select name="status_game" id="status_game" required>
            <option value="Alpha" <%= game.Status_Game==="Alpha" ? "selected" : "" %>>Alpha</option>
            <option value="Beta" <%= game.Status_Game==="Beta" ? "selected" : "" %>>Beta</option>
            <option value="Released" <%= game.Status_Game==="Released" ? "selected" : "" %>>Released</option>
        </select>
        <br>

        <!-- รายละเอียดเพิ่มเติม -->
        <label for="Details">Details:</label>
        <textarea name="Details" id="Details"><%= game.Details %></textarea>
        <br>

        <!-- Tags -->
        <label for="tags">Tags:</label>
        <select id="tags" name="tags[]" multiple="multiple">
            <option value="Action" <%= game.tags?.Action ? "selected" : "" %>>Action</option>
            <option value="Adventure" <%= game.tags?.Adventure ? "selected" : "" %>>Adventure</option>
            <option value="Card_Game" <%= game.tags?.Card_Game ? "selected" : "" %>>Card Game</option>
            <option value="Educational" <%= game.tags?.Educational ? "selected" : "" %>>Educational</option>
            <option value="Fighting" <%= game.tags?.Fighting ? "selected" : "" %>>Fighting</option>
            <option value="Interactive_Fiction" <%= game.tags?.Interactive_Fiction ? "selected" : "" %>>
                Interactive Fiction
            </option>
            <option value="Puzzle" <%= game.tags?.Puzzle ? "selected" : "" %>>Puzzle</option>
            <option value="Racing" <%= game.tags?.Racing ? "selected" : "" %>>Racing</option>
            <option value="Other" <%= game.tags?.Other ? "selected" : "" %>>Other</option>
        </select>
        <br>

        <!-- ปุ่มอัปเดต -->
        <button type="submit">Update</button>
    </form>

    <!-- ==========================
         Scripts
         ========================== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // ==========================
        // 1) Initial select2 (multi-select)
        // ==========================
        $(document).ready(function () {
            $('#tags').select2({
                placeholder: "เลือก Tags",
                allowClear: true,
                tags: true
            });
        });
    </script>
</body>

</html>
