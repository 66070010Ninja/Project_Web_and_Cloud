<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Level Zero</title>
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>

    <header class="top-bar">
        <h1>LEVEL ZERO</h1>
    </header>

    <main class="login-main">
        <div class="login-container">
            <h2>Log in to your account</h2>
            
            <% 
                // 💡 ใช้ข้อความ error จาก Controller หรือ flash message (res.locals.errorMessage)
                const displayError = (typeof error !== 'undefined' && error) 
                                     ? error 
                                     : (typeof errorMessage !== 'undefined' ? errorMessage : null); 
            %>

            <% if (displayError && displayError.length > 0) { %>
                <% 
                    const messages = Array.isArray(displayError) ? displayError : [displayError];
                    messages.forEach(msg => { %>
                        <p class="error-message flash-error"><%= msg %></p>
                <% }); %>
            <% } %>
            
            <form action="/user/login" method="post">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" 
                                id="username" 
                                name="username" 
                                placeholder="Enter your username"
                                value="<%= formData && formData.username ? formData.username : '' %>" 
                                required>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" 
                                id="password" 
                                name="password" 
                                placeholder="Enter your password"
                                required>
                </div>

                <button type="submit" class="login-btn">Login</button>
            </form>
            
            <p class="register-prompt">
                Don't have an account? <a href="/user/register">Sign Up</a>
            </p>

        </div>
    </main>

</body>

</html>