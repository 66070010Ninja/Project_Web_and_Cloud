<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Page</title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <%- include('partials/navbar') %>

    <main class="admin-main">
        <div class="container">
            <div class="admin-header">
                <h1>Admin Panel</h1>
            </div>
            
            <div class="section-header">
                <h2>Manage All Games</h2>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger" style="color: red; padding: 10px; border: 1px solid red; margin-bottom: 20px;">
                    <strong>Error:</strong> <%= error %>
                </div>
            <% } %>

            <% if (games && games.length > 0) { %>
                <div class="game-list-container">
                    <% games.forEach(game => { %>
                        <div class="game-list-item">
                            <a href="/game/view/<%= game.Game_ID %>" class="game-list-image">
                                <img src="<%= game.Game_Cover %>" alt="<%= game.Game_Title %> Cover">
                            </a>
                            <div class="game-list-details">
                                <h3 class="game-list-title"><%= game.Game_Title %></h3>
                                <div class="game-list-stats">
                                    <span><i class="fas fa-eye"></i> <%= game.views || 0 %></span>
                                    <span><i class="fas fa-download"></i> <%= game.downloads || 0 %></span>
                                </div>
                            </div>
                            <div class="game-list-actions">
                                <form action="/game/delete/<%= game.Game_ID %>?from=admin" method="POST" onsubmit="return confirm('Are you sure you want to delete this game?');">
                                    <button type="submit" class="btn btn-delete"><i class="fas fa-trash-alt"></i> Delete</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="no-games-message">
                    <p>No games found in the system.</p>
                </div>
            <% } %>
        </div>
    </main>

</body>
</html>