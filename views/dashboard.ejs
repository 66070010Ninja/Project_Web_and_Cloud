<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Dashboard</title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <%- include('partials/navbar') %>

    <main class="dashboard-main">
        <div class="container">
            <div class="dashboard-header">
                <h1>Dashboard</h1>
                <a href="/game/create" class="btn btn-primary"><i class="fas fa-plus"></i> Create New Game</a>
            </div>
            
            <% 
            let totalViews = 0;
            let totalDownloads = 0;
            if (games && games.length > 0) {
                games.forEach(game => {
                    totalViews += game.views || 0;
                    totalDownloads += game.downloads || 0;
                });
            }
            %>

            <div class="section-header">
                <h2>My Games</h2>
                <div class="total-stats">
                    <span><i class="fas fa-eye"></i> Total Views: <%= totalViews %></span>
                    <span><i class="fas fa-download"></i> Total Downloads: <%= totalDownloads %></span>
                </div>
            </div>

            <% if (games && games.length > 0) { %>
                <div class="game-list-container">
                    <% games.forEach(game => { %>
                        <div class="game-list-item">
                            <a href="/game/view/<%= game.Game_ID %>" class="game-list-image">
                                <img src="<%= game.Game_Cover %>" alt="<%= game.Game_Title %> Cover">
                            </a>
                            <div class="game-list-details">
                                <h3 class="game-list-title"><%= game.Game_Title %></h3>
                                <div class="game-list-stats">
                                    <span><i class="fas fa-eye"></i> <%= game.views || 0 %></span>
                                    <span><i class="fas fa-download"></i> <%= game.downloads || 0 %></span>
                                </div>
                            </div>
                            <div class="game-list-actions">
                                <a href="/game/edit/<%= game.Game_ID %>" class="btn btn-edit"><i class="fas fa-pencil-alt"></i> Edit</a>
                                <form action="/game/delete/<%= game.Game_ID %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this game?');">
                                    <button type="submit" class="btn btn-delete"><i class="fas fa-trash-alt"></i> Delete</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="no-games-message">
                    <p>You haven't created any games yet.</p>
                    <a href="/game/create" class="btn btn-primary">Create Your First Game</a>
                </div>
            <% } %>
        </div>
    </main>

</body>
</html>