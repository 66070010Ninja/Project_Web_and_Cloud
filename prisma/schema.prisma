// ==========================
// schema.prisma
// ==========================

// --------------------------
// Prisma Client Generator
// --------------------------
generator client {
  provider = "prisma-client-js"
}

// --------------------------
// Database Connection
// --------------------------
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // กำหนดในไฟล์ .env
}

// --------------------------
// Models
// --------------------------

// ==========================
// Account Model (ผู้ใช้งาน)
// ==========================
model account {
  User_id         Int    @id @default(autoincrement()) // Primary Key
  User_Name       String @unique                       // ชื่อผู้ใช้ (ไม่ซ้ำกัน)
  Email           String
  Hashed_Password String
  Roles           String @default("Member")            // Default: Member

  // ความสัมพันธ์
  games  games[]
  review review[]
  Profile_Image user_image[]
}

// ==========================
// Games Model (เกม)
// ==========================
model games {
  Game_id      Int     @id @default(autoincrement()) // Primary Key
  User_id      Int                                   // FK -> account
  Game_Title   String  @db.VarChar(255)
  Description  String? @db.Text
  File_Game    String  @db.VarChar(255)
  Status_Game  String? @db.VarChar(255)
  Log_Game     String? @db.VarChar(255)
  Hidding_Game Int     @default(1)
  Soft_Delete  Int     @default(1)
  View         Int     @default(0)
  Download     Int     @default(0)
  Game_Engin   String? @db.VarChar(255)
  Details      String? @db.Text

  // ความสัมพันธ์
  account account      @relation(fields: [User_id], references: [User_id])
  Game_Images  game_image[]
  review  review[]
  tags    tags?
}

// ==========================
// Game Image Model (รูปเกม)
// ==========================
model game_image {
  Game_Image_id Int    @id @default(autoincrement()) // Primary Key
  Path          String
  Game_id       Int

  // ความสัมพันธ์
  games games @relation(fields: [Game_id], references: [Game_id])
}

model user_image {
  User_Image_id Int   @id @default(autoincrement()) // Primary Key
  Path          String
  User_id       Int

  account account @relation(fields: [User_id], references: [User_id])
}

// ==========================
// Review Model (รีวิวเกม)
// ==========================
model review {
  Review_id  Int      @id @default(autoincrement()) // Primary Key
  Game_id    Int                                    // FK -> games
  User_id    Int                                    // FK -> account
  Comment    String?  @db.Text
  Created_At DateTime @default(now())

  // ความสัมพันธ์
  games   games   @relation(fields: [Game_id], references: [Game_id])
  account account @relation(fields: [User_id], references: [User_id])
}

// ==========================
// Tags Model (หมวดหมู่เกม)
// ==========================
model tags {
  Game_id             Int @id @default(autoincrement()) // Primary Key
  Action              Int @default(0)
  Adventure           Int @default(0)
  Card_Game           Int @default(0)
  Educational         Int @default(0)
  Fighting            Int @default(0)
  Interactive_Fiction Int @default(0)
  Puzzle              Int @default(0)
  Racing              Int @default(0)
  Other               Int @default(0)

  // ความสัมพันธ์
  games games @relation(fields: [Game_id], references: [Game_id], onDelete: NoAction, onUpdate: NoAction, map: "tags_ibfk_1")
}
