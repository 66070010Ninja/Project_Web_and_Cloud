// ==========================
// schema.prisma
// ==========================

// ==========================
// Generator สำหรับ Prisma Client
// ==========================
generator client {
  provider = "prisma-client-js"
}

// ==========================
// Datasource สำหรับเชื่อมต่อ MySQL
// ==========================
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // URL จากไฟล์ .env
}

// ==========================
// ตาราง account สำหรับผู้ใช้
// ==========================
model account {
  User_id   Int      @id @default(autoincrement())
  User_Name String   @unique
  Email     String
  Hashed_Password String
  Roles     String   @default("Member")
  Profile_Image String @default("Profile.png")

  // ความสัมพันธ์
  games  games[]
  review review[]  // one-to-many
}


// ==========================
// ตาราง games สำหรับเกม
// ==========================
model games {
  Game_id      Int       @id @default(autoincrement())
  User_id      Int
  Game_Title   String    @db.VarChar(255)
  Description  String?   @db.VarChar(255)
  Game_Image   String    @db.VarChar(255)
  File_Game    String    @db.VarChar(255)
  Status_Game  String?   @db.VarChar(255)
  Log_Game     String?   @db.VarChar(255)
  Hidding_Game Int       @default(1)
  Soft_Delete  Int       @default(1)
  View         Int       @default(0)
  Download     Int       @default(0)
  Game_Engin   String?   @db.VarChar(255)
  Details      String?   @db.VarChar(255)

  // ความสัมพันธ์
  account account @relation(fields: [User_id], references: [User_id])
  review  review[] // เปลี่ยนเป็น one-to-many
  tags    tags? 
}

// ==========================
// ตาราง review สำหรับคอมเมนต์ของผู้ใช้ต่อเกม
// ==========================
model review {
  Review_id  Int      @id @default(autoincrement()) // PRIMARY KEY ใหม่
  Game_id    Int
  User_id    Int
  Comment    String?  @db.VarChar(255)
  Created_At DateTime @default(now())

  games   games   @relation(fields: [Game_id], references: [Game_id])
  account account @relation(fields: [User_id], references: [User_id])
}


// ==========================
// ตาราง tags สำหรับประเภทของเกม
// ==========================
model tags {
  Game_id             Int   @id @default(autoincrement()) // Primary key
  Action              Int   @default(0)
  Adventure           Int   @default(0)
  Card_Game           Int   @default(0)
  Educational         Int   @default(0)
  Fighting            Int   @default(0)
  Interactive_Fiction Int   @default(0)
  Puzzle              Int   @default(0)
  Racing              Int   @default(0)
  Other               Int   @default(0)

  // ความสัมพันธ์
  games               games @relation(fields: [Game_id], references: [Game_id], onDelete: NoAction, onUpdate: NoAction, map: "tags_ibfk_1")
}
