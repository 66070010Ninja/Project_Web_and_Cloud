# ==========================
# Database configuration
# ==========================

DB_HOST = "localhost"       # ที่อยู่ host ของฐานข้อมูล (localhost สำหรับเครื่องตัวเอง)
DB_USER = "root"            # ชื่อผู้ใช้ MySQL
DB_PASSWORD = "08197"       # รหัสผ่านผู้ใช้ MySQL
DB_CONTAINER = "level_zero" # ชื่อของ Container
DB_NAME = "level_zero"      # ชื่อฐานข้อมูลที่จะใช้งาน
DB_PORT = "3306"            # พอร์ตของ MySQL (ค่า default คือ 3306)
JWT_SECRET = "level_zero_secret"

# ==========================
# Prisma environment notes
# ==========================
# ตัวแปรสภาพแวดล้อมที่ประกาศในไฟล์นี้จะถูก Prisma ใช้งานโดยอัตโนมัติ
# Prisma รองรับ connection string สำหรับหลายฐานข้อมูล เช่น
# PostgreSQL, MySQL, SQLite, SQL Server, MongoDB, CockroachDB
# ดูรายละเอียดเพิ่มเติม: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema
# ดูตัวอย่างการเชื่อมต่อ MySQL: https://pris.ly/d/connection-strings

# ==========================
# Prisma DATABASE_URL
# ==========================
# ใช้ตัวแปรด้านบนมาแทนที่เพื่อสร้าง connection string สำหรับ Prisma
DATABASE_URL = "mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
