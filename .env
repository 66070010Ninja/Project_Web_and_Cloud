# .env

# Database configuration
DB_HOST = "localhost"       # ที่อยู่ host ของฐานข้อมูล (localhost สำหรับเครื่องตัวเอง)
DB_USER = "root"            # ชื่อผู้ใช้ MySQL
DB_PASSWORD = "08197"       # รหัสผ่านผู้ใช้ MySQL
DB_NAME = "level_zero"      # ชื่อฐานข้อมูลที่จะใช้งาน
DB_PORT = "3306"            # พอร์ตของ MySQL (ค่า default คือ 3306)

# คำอธิบายจาก `prisma init`:
# ตัวแปรสภาพแวดล้อมที่ประกาศในไฟล์นี้จะถูก Prisma ใช้งานโดยอัตโนมัติ
# สามารถดูรายละเอียดเพิ่มเติมได้ที่: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma รองรับ connection string สำหรับหลายฐานข้อมูล เช่น PostgreSQL, MySQL, SQLite, SQL Server, MongoDB และ CockroachDB
# ดูรายละเอียดการเชื่อมต่อทั้งหมดได้ที่: https://pris.ly/d/connection-strings

# ตัวอย่าง URL การเชื่อมต่อ MySQL สำหรับ Prisma
DATABASE_URL = "mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
# DATABASE_URL นี้ใช้ตัวแปรด้านบนมาแทนที่เพื่อสร้าง connection string สำหรับ Prisma
